# Copy to .env and fill in. Never commit .env. Never paste these values in chat or Slack.

# Apollo (account search, people search, enrichment, phones). Paid, credit based.
APOLLO_API_KEY=

# Blissgrowth n8n: API key (workflow deploys, activity checker switch, phone data table)
BLISSGROWTH_N8N_API_KEY=

# Blissgrowth n8n base URL, e.g. https://your-n8n.example.com (no trailing slash)
BLISSGROWTH_N8N_INSTANCE_URL=

# HeyReach API key for the Blissgrowth workspace (draft campaigns, sender account list)
HEYREACH_API_KEY=

# MillionVerifier key (email verification; without it emails stay unverified)
MILLIONVERIFIER_API_KEY=

# Optional: Apify token, only used when rebuilding the activity checker workflow (engine/vendor/activity-checker)
# APIFY_TOKEN=

# Optional: override where the repo root is (default: auto detected from the .idea-launch-root marker)
# IDEA_LAUNCH_ROOT=
